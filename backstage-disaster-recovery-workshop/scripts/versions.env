# Single source of truth for tool and image versions used in the workshop.
# Every image is pinned to a tag and a digest (the multi-arch index, so it runs on
# amd64 Codespaces and arm64 laptops alike). To bump one, check the tag exists and
# take its digest with: crane digest <image>:<tag>
KIND_VERSION=v0.33.0
# kind's default node image for KIND_VERSION (from the kind release notes). Docker Hub: unavoidable.
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
BACKSTAGE_IMAGE=ghcr.io/backstage/backstage:1.55.2@sha256:68f2025a3f2774e04d58a65a948ccd04a93ddab7b7977be850e9df6d3beae6e3
POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:18.6-minimal-trixie@sha256:0675340b02be838319b9b6f323c206693e519dcd62ec729d539be9f46bb7a2f9
# The newest nginx tag on ghcr.io. Newer ones are only on Docker Hub; this one only serves one static file.
NGINX_IMAGE=ghcr.io/nginxinc/nginx-unprivileged:1.27.4-alpine-slim@sha256:2ff8b79ebe8a9bb403306866850faefe2ef9f447841767b25ba4d0b49518b541
