# Single source of truth for tool versions used in the workshop.
# The Helm chart version decides which Argo CD version is installed;
# keep ARGOCD_VERSION (used for the CLI) in step with the chart's appVersion.
# The chart itself ships in charts/. To bump it, download the new version there:
#   helm pull argo-cd --repo https://argoproj.github.io/argo-helm --version <version> -d charts
ARGOCD_CHART_VERSION=10.10.1
ARGOCD_VERSION=v3.5.4
KIND_VERSION=v0.33.0
